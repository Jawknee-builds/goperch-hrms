// Prisma schema for GoPerch HRMS
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Department {
  id          String      @id @default(uuid())
  name        String      @unique
  code        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users       User[]
  tasks       Task[]
  milestones  Milestone[]
  channels    Channel[]
  projects    Project[]
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  password        String
  name            String
  role            String      @default("EMPLOYEE") // CEO, HOD, EMPLOYEE
  title           String?
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  isArchived      Boolean     @default(false)
  deletedAt       DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tasksCreated    Task[]      @relation("CreatedTasks")
  tasksAssigned   Task[]      @relation("AssignedTasks")
  skills          UserSkill[]
  hurdlesAsked    Hurdle[]    @relation("AskedHurdles")
  hurdlesAnswered Hurdle[]    @relation("AnsweredHurdles")

  messagesSent    Message[]   @relation("SentMessages")
  messagesReceived Message[]  @relation("ReceivedMessages")
  projectsCreated Project[]   @relation("CreatedProjects")
  projectNotes    ProjectNote[]
  taskComments    TaskComment[]
  notifications   Notification[]
}

model Milestone {
  id           String     @id @default(uuid())
  title        String
  description  String?
  targetDate   DateTime
  status       String     @default("IN_PROGRESS") // PLANNED, IN_PROGRESS, COMPLETED
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  tasks        Task[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Project {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       String       @default("IN_PROGRESS")
  progress     Int          @default(0)
  isTopFocus   Boolean      @default(false)
  targetDate   DateTime?

  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdById  String
  createdBy    User         @relation("CreatedProjects", fields: [createdById], references: [id])

  tasks        Task[]
  notes        ProjectNote[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ProjectNote {
  id          String   @id @default(uuid())
  content     String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  status       String     @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED
  priority     String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate      DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdById  String
  createdBy    User       @relation("CreatedTasks", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?      @relation("AssignedTasks", fields: [assignedToId], references: [id])

  milestoneId  String?
  milestone    Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  hurdles      Hurdle[]
  comments     TaskComment[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String
  userSkills  UserSkill[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  proficiency String   @default("LEARNING") // LEARNING, INTERMEDIATE, ADVANCED, MASTERED
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, skillId])
}

model Hurdle {
  id           String   @id @default(uuid())
  title        String
  question     String
  answer       String?
  status       String   @default("OPEN") // OPEN, RESOLVED

  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  askedById    String
  askedBy      User     @relation("AskedHurdles", fields: [askedById], references: [id])

  answeredById String?
  answeredBy   User?    @relation("AnsweredHurdles", fields: [answeredById], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Channel {
  id           String      @id @default(uuid())
  name         String      @unique
  description  String?
  isPrivate    Boolean     @default(false)
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  messages     Message[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Message {
  id          String    @id @default(uuid())
  content     String

  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  channelId   String?
  channel     Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   User?     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
